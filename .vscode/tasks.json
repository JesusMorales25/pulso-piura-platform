{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pulso: infraestructura",
      "type": "shell",
      "command": "docker compose up -d postgres keycloak",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Pulso: backend",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/run-backend.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$javac"],
      "isBackground": true,
      "presentation": { "group": "pulso", "reveal": "always" }
    },
    {
      "label": "Pulso: frontend",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/run-frontend.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "group": "pulso", "reveal": "always" }
    },
    {
      "label": "Pulso: preparar puerto compartido",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/start-vscode-share.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
