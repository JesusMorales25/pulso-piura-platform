# Backend only. Copy parameters from Supabase Connect > Session pooler (5432).
# Do not use a postgres:// URI, API keys, or credentials embedded in this URL.
DATABASE_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require&connectTimeout=10&socketTimeout=60&tcpKeepAlive=true
POSTGRES_USER=pulso_app.YOUR_PROJECT_REF
POSTGRES_PASSWORD=REPLACE_WITH_RUNTIME_ROLE_PASSWORD
# Flyway owns schema changes; runtime role has only data access.
MIGRATION_DATABASE_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require&connectTimeout=10&socketTimeout=60&tcpKeepAlive=true
MIGRATION_POSTGRES_USER=postgres.YOUR_PROJECT_REF
MIGRATION_POSTGRES_PASSWORD=REPLACE_WITH_SUPABASE_DATABASE_PASSWORD
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
PAYMENTS_MODE=external_manual
PAYMENT_PROOF_STORAGE=supabase
SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=payment-proofs
# Server secret API key from Supabase Settings > API Keys. Never NEXT_PUBLIC.
SUPABASE_STORAGE_SECRET_KEY=REPLACE_WITH_SB_SECRET_KEY
EXTERNAL_PAYMENT_REVIEW_MINUTES=30
PAYMENT_PROOF_RETENTION_DAYS=90
# For the optional VPS + external database variant only:
API_DOMAIN=api.example.com
OIDC_ISSUER_URI=https://YOUR_TENANT.auth0.com/
OIDC_JWK_SET_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
OIDC_AUDIENCE=https://api.example.com
WEB_ALLOWED_ORIGIN=https://YOUR_FRONTEND.vercel.app
