POSTGRES_DB=pulso_piura
POSTGRES_USER=pulso_app
POSTGRES_PASSWORD=REEMPLAZAR_LOCALMENTE
POSTGRES_PORT=5433
KEYCLOAK_ADMIN=admin_local
KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR_LOCALMENTE
OIDC_ISSUER_URI=http://localhost:8180/realms/pulso-piura
OIDC_JWK_SET_URI=http://localhost:8180/realms/pulso-piura/protocol/openid-connect/certs
OIDC_AUDIENCE=pulso-api
AUTH_PROVIDER=keycloak
OIDC_CLAIMS_NAMESPACE=https://pulsopiura.app
OIDC_ROLES_CLAIM=https://pulsopiura.app/roles
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/pulso-piura
NEXT_PUBLIC_OIDC_CLIENT_ID=pulso-web
NEXT_PUBLIC_AUTH_PROVIDER=keycloak
NEXT_PUBLIC_OIDC_AUDIENCE=pulso-api
NEXT_PUBLIC_OIDC_ROLES_CLAIM=https://pulsopiura.app/roles
# Auth0 local: completa estos valores publicos y ejecuta start-local.ps1 -AuthProvider auth0.
# Los valores de Keycloak anteriores se conservan para cambiar de proveedor sin reescribirlos.
AUTH0_OIDC_ISSUER_URI=https://TU_TENANT.auth0.com/
AUTH0_OIDC_JWK_SET_URI=https://TU_TENANT.auth0.com/.well-known/jwks.json
AUTH0_OIDC_AUDIENCE=https://api.pulsopiura.app
AUTH0_OIDC_CLIENT_ID=TU_CLIENT_ID_PUBLICO
# Nunca agregues el Client Secret de Auth0 al frontend ni a este archivo versionado.
WEB_ALLOWED_ORIGIN=http://localhost:3000
RESERVATION_HOLD_DURATION=PT5M
RESERVATION_MAX_ACTIVE_TEMPORARY_PER_CUSTOMER=3
# Inicio de sesión federado. El secret solo llega al bootstrap de Keycloak.
# Redirect URI local en Google Cloud:
# http://localhost:8180/realms/pulso-piura/broker/google/endpoint
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
KEYCLOAK_PUBLIC_URL=http://localhost:8180
FRONTEND_PUBLIC_URL=http://localhost:3000
PASSWORD_REGISTRATION_ENABLED=true
RESET_BOOTSTRAP_USER_PASSWORDS=true
TEST_USER_EMAIL=REEMPLAZAR_LOCALMENTE
TEST_USER_PASSWORD=REEMPLAZAR_LOCALMENTE
DEMO_OWNER_EMAIL=propietario.local@pulsopiura.test
DEMO_ORGANIZER_EMAIL=organizador.local@pulsopiura.test
DEMO_ADMIN_EMAIL=admin.organizacion.local@pulsopiura.test
DEMO_OPERATOR_EMAIL=operador.local@pulsopiura.test
DEMO_PLATFORM_ADMIN_EMAIL=admin.plataforma.local@pulsopiura.test

# En desarrollo local no se envían correos. En producción usa true y configura SMTP en Keycloak.
LOCAL_REQUIRE_EMAIL_VERIFICATION=false
# start-local conserva únicamente el administrador global. seed-demo-data.ps1
# habilita temporalmente el resto de identidades cuando se solicitan datos demo.
LOCAL_DEMO_USERS_ENABLED=false

# disabled by default; simulation only for local testing, never collects money
PAYMENTS_MODE=disabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
